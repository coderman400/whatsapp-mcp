{
  "name": "whatsapp-mcp",
  "version": "0.1.0",
  "description": "A WhatsApp MCP server built on Baileys: lets AI agents read, search and send your WhatsApp messages through a local daemon.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "whatsapp-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc"
  },
  "keywords": [
    "whatsapp",
    "mcp",
    "model-context-protocol",
    "baileys",
    "ai-agent",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "12.11.1",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.25",
    "@types/qrcode": "1.5.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coderman400/whatsapp-mcp"
  }
}
